# --- Django ---
DJANGO_SECRET_KEY=dev-only-change-me
DEBUG=True
ALLOWED_HOSTS=*

# --- Database ---
# Host-OS PostgreSQL, database "solar_hub", reached from the container via
# host.docker.internal. PORT: host PG is on 5432. If a native PG ever takes
# 5432 and yours moves (e.g. 5433), change ONLY this port — it is hard-coded
# nowhere else.
DATABASE_URL=postgres://postgres:postgres@host.docker.internal:5432/solar_hub

# --- Redis (Celery broker + result backend + cache) ---
REDIS_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CACHE_URL=redis://redis:6379/1

# --- Site health-check (periodic) ---
# TIMEOUT: per-call timeout (s) for the system_status round-trip.
# OK/FAIL INTERVAL (s): re-check cadence. Sites that passed are re-checked every
# OK interval (default 10 min); failed/unreachable ones retry every FAIL interval
# (default 5 min). FAIL interval also sets the Celery beat tick; keep it <= OK.
SITE_HEALTHCHECK_TIMEOUT_SECONDS=60
SITE_HEALTHCHECK_OK_INTERVAL_SECONDS=600
SITE_HEALTHCHECK_FAIL_INTERVAL_SECONDS=300
ORDER_POLL_INTERVAL_SECONDS=480

# --- CORS / CSRF (only matters for dev-on-host Vite at :5173) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:8000

# --- Fernet key for encrypting WooCommerce consumer_secret ---
# Generate: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
FERNET_KEY=REPLACE_WITH_GENERATED_FERNET_KEY
