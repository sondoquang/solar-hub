# --- Django ---
DJANGO_SECRET_KEY=dev-only-change-me
DEBUG=True
ALLOWED_HOSTS=*

# --- Database ---
# Host-OS PostgreSQL, database "solar_hub", reached from the container via
# host.docker.internal. PORT: host PG is on 5432. If a native PG ever takes
# 5432 and yours moves (e.g. 5433), change ONLY this port — it is hard-coded
# nowhere else.
DATABASE_URL=postgres://postgres:postgres@host.docker.internal:5432/solar_hub

# --- Redis (Celery broker + result backend + cache) ---
REDIS_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CACHE_URL=redis://redis:6379/1

# --- Site health-check (periodic) ---
# TIMEOUT: per-call timeout (s) for the system_status round-trip.
# OK/FAIL INTERVAL (s): re-check cadence. Sites that passed are re-checked every
# OK interval (default 10 min); failed/unreachable ones retry every FAIL interval
# (default 5 min). FAIL interval also sets the Celery beat tick; keep it <= OK.
SITE_HEALTHCHECK_TIMEOUT_SECONDS=60
SITE_HEALTHCHECK_OK_INTERVAL_SECONDS=600
SITE_HEALTHCHECK_FAIL_INTERVAL_SECONDS=300
ORDER_POLL_INTERVAL_SECONDS=480

# --- Domain info (WHOIS / DNS / SSL / blacklist / Google index) ---
# TICK: beat cadence; the dispatcher only refreshes sites whose snapshot is
# older than REFRESH_INTERVAL (default 24h), BATCH_SIZE sites per sub-task,
# WORKERS concurrent lookups per batch.
DOMAIN_INFO_TICK_SECONDS=3600
DOMAIN_INFO_REFRESH_INTERVAL_SECONDS=86400
DOMAIN_INFO_BATCH_SIZE=10
DOMAIN_INFO_WORKERS=4
DOMAIN_LOOKUP_TIMEOUT_SECONDS=10
# DNS resolver IP for record lookups + DNSBL queries. Empty = system resolver.
# NOTE: Spamhaus refuses public resolvers (8.8.8.8/1.1.1.1) — blacklist results
# will show "Không xác định" until this points at a resolver allowed to query.
DOMAIN_DNS_RESOLVER=
# Google index check (Custom Search JSON API). Leave the key empty to skip the
# check entirely. Own cadence (default 7 days) stays under the free
# 100-queries/day quota for ~100 domains.
DOMAIN_GINDEX_INTERVAL_SECONDS=604800
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=

# --- CORS / CSRF (only matters for dev-on-host Vite at :5173) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:8000

# --- Fernet key for encrypting WooCommerce consumer_secret ---
# Generate: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
FERNET_KEY=REPLACE_WITH_GENERATED_FERNET_KEY

# Public base URL of the Hub (no trailing slash) used for product-image links
# pushed to WooCommerce sites — the sites must be able to download from it.
# Leave empty in pure-local dev (sandbox Woo on the same machine).
MEDIA_PUBLIC_BASE_URL=

# --- Logging ---
# Mức log gốc cho các app (apps.*). Override theo app: LOG_LEVEL_CATALOG=DEBUG ...
LOG_LEVEL=INFO
# Thư mục ghi file log (mặc định <backend>/logs). Trong Docker nên để /app/logs.
# LOG_DIR=/app/logs
# Tên file log của process. Trong docker-compose mỗi service đặt tên riêng
# (web.log / celery-*.log) để RotatingFileHandler không xoay vòng đè nhau.
# LOG_FILE_NAME=backend.log
LOG_FILE_MAX_BYTES=10000000
LOG_FILE_BACKUP_COUNT=5
